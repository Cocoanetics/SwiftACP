# SwiftPM
.build/
.swiftpm/
# Package.resolved is intentionally NOT committed. The spawn-client's swift-subprocess
# dependency pulls swift-docc-plugin → swift-syntax, a graph older resolvers (Swift 6.2)
# can't navigate (it exhausts); the Swift 6.4 toolchains CI uses (Xcode 27.1 on Apple,
# swift.org 6.4.2 on Linux, Windows and Android) resolve it unaided. So no lock is needed.
Package.resolved

# Build output lives on the external SSD, never under the repo
# (see CLAUDE.md). Keep these ignored just in case.
build/
DerivedData/

# macOS
.DS_Store

# Editor
*.xcodeproj
*.xcworkspace

# Claude Code local (per-user) settings
.claude/settings.local.json
